# ==============================================================================
# Portal SPC/SECMA - Configuração de Ambiente (.env.example)
# ==============================================================================
# Copie este arquivo para .env.local (desenvolvimento/homologação) ou configure no CI/CD.
# NUNCA adicione chaves privadas (Service Accounts, chaves de API de backend/IA)
# em variáveis com prefixo VITE_, pois elas são embutidas no bundle público.
# ==============================================================================

# Ambiente de execução: development | homologation | production
VITE_APP_ENV=homologation

# Alvo de build opcional: firebase (padrão, gera dist/) | cloudflare (gera dist/client e dist/server)
VITE_DEPLOY_TARGET=firebase

# Configuração do Firebase Web SDK (projeto de homologação: spc-maranhao-homologacao)
VITE_FIREBASE_API_KEY=<preencher-no-env-local-ou-github-secrets>
VITE_FIREBASE_AUTH_DOMAIN=spc-maranhao-homologacao.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=spc-maranhao-homologacao
VITE_FIREBASE_STORAGE_BUCKET=spc-maranhao-homologacao.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=<preencher-no-env-local-ou-github-secrets>
VITE_FIREBASE_APP_ID=<preencher-no-env-local-ou-github-secrets>

# E-mail do SuperAdmin institucional (deve coincidir com firestore.rules e storage.rules)
VITE_SUPER_ADMIN_EMAIL=leplonghi@gmail.com
