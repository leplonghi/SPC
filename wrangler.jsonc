{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "biblioteca-normas-spc-maranhao",
  "compatibility_date": "2026-05-22",
  "main": "./worker/index.js",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
