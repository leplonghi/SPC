rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function hasRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }
    
    // Administrador total do portal (definido pelo Eduardo em 11/10/2026).
    // Exige o e-mail verificado pelo provedor (Google). Se trocar o e-mail, troque também em storage.rules e data/adminConfig.ts.
    function isSuperAdminEmail() {
      return isAuthenticated()
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'leplonghi@gmail.com';
    }

    function isAdmin() {
      return isSuperAdminEmail() || hasRole('SuperAdmin') || hasRole('AdminSPC');
    }
    
    function isEditor() {
      return isAdmin() || hasRole('EditorDPE') || hasRole('EditorDPHAP') || hasRole('EditorDPI');
    }

    // Heritage Assets and Areas
    // Allow public read access
    // Allow write access only to Editors and Admins
    match /heritage_assets/{document} {
      allow read: if true;
      allow write: if isEditor();
    }
    
    match /heritage_areas/{document} {
      allow read: if true;
      allow write: if isEditor();
    }

    // Public legislation library
    // Visitors can read only records that completed the editorial workflow.
    // Editors and administrators retain control over drafts and publication.
    match /legislation/{document} {
      allow read: if resource.data.status == 'published';
      allow create, update, delete: if isEditor();
    }
    
    // Users Collection
    // Authenticated users can read their own profile
    // Admins can read all profiles
    // Admins can write to any profile (to manage roles)
    // Users can create their own profile ONLY if setting role to 'Viewer' (for initial signup)
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin() || isEditor());
      allow write: if isAdmin();
      allow create: if isAuthenticated() && request.auth.uid == userId && request.resource.data.role == 'Viewer';
    }
    
    match /enrichment_queue/{document} {
      allow create: if isEditor();
      allow read, update, delete: if isEditor();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false; 
    }
  }
}
